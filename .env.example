# --- MongoDB ---
# Either a local native install (mongodb://localhost:27017) or a hosted cluster like
# MongoDB Atlas (mongodb+srv://user:pass@cluster.mongodb.net/).
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=broll_notetaker

# --- Redis (job queue) ---
# Must be the TCP/"rediss://" connection string (RQ needs blocking commands that only
# work over the real Redis protocol) - NOT a REST API URL/token pair like Upstash's
# separate REST credentials.
REDIS_URL=redis://localhost:6379

# --- Google Calendar (Scheduler) ---
# Personal Gmail account: use scripts/bootstrap_calendar_auth.py (OAuth login) - see README.
# Google Workspace account: swap calendar_client.py back to a service account with
# domain-wide delegation instead, if you ever move demos to a Workspace calendar.
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TOKEN_PATH=/opt/broll-notetaker/secrets/google-calendar-token.json
# Only events whose title/description matches this pattern trigger the bot.
DEMO_EVENT_KEYWORD=demo
# How many minutes before the event start the bot should join.
JOIN_LEAD_MINUTES=1

# --- Meet bot account (Meet-Join Worker) ---
BOT_GOOGLE_EMAIL=notes@trybroll.com
BOT_DISPLAY_NAME=Broll Notetaker (Recording)
AUDIO_OUTPUT_DIR=/opt/broll-notetaker/data/audio
# Path to Playwright storage_state.json produced by scripts/bootstrap_auth.py
GOOGLE_AUTH_STATE_PATH=/opt/broll-notetaker/secrets/google-auth-state.json
PULSE_MONITOR_SOURCE=meet_sink.monitor

# --- Transcription Worker ---
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Notes Generator (OpenRouter - free-tier model by default) ---
OPENROUTER_API_KEY=changeme
# Check https://openrouter.ai/models?max_price=0 for the current free-model list —
# free model availability/names change over time, swap this if one gets deprecated.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- Delivery ---
SLACK_WEBHOOK_URL=
SLACK_ENABLED=false

# --- Backend (FastAPI serves both the API and the dashboard) ---
API_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
