[Unit]
Description=Broll Notetaker transcription worker (RQ queue: transcribe-audio, faster-whisper)
After=network.target mongod.service redis-server.service

[Service]
User=broll
WorkingDirectory=/opt/broll-notetaker
EnvironmentFile=/opt/broll-notetaker/.env
Environment=PYTHONPATH=/opt/broll-notetaker
ExecStart=/bin/sh -c '/opt/broll-notetaker/.venv/bin/rq worker transcribe-audio --url "$REDIS_URL"'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
