[Unit]
Description=Broll Notetaker meet-worker (joins Google Meet, tracks attendance, records audio)
After=network.target mongod.service redis-server.service broll-xvfb.service broll-pulseaudio.service
Requires=broll-xvfb.service broll-pulseaudio.service

[Service]
User=broll
WorkingDirectory=/opt/broll-notetaker
EnvironmentFile=/opt/broll-notetaker/.env
Environment=PYTHONPATH=/opt/broll-notetaker
Environment=DISPLAY=:99
# Must match broll-pulseaudio.service's RuntimeDirectory so this process finds that socket.
Environment=XDG_RUNTIME_DIR=/run/broll-pulse
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
ExecStart=/bin/sh -c '/opt/broll-notetaker/.venv/bin/rq worker join-meeting --url "$REDIS_URL"'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
